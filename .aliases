# Navigation
alias ..="cd .."
alias ...="cd ../.."

# eza
alias l="eza"
alias ll="eza -lah --git"
alias la="eza -a"
alias lt="eza --tree --level=2"

# Git
alias g="git"
alias gs="git status"
alias ga="git add"
alias gaa="git add --all"
alias gc="git commit"
alias gp="git push"
alias gl="git pull"
alias gd="git diff"
alias gb="git branch"
alias glog="git log --graph --decorate --oneline --all"

# Docker
alias d="docker"
alias dc="docker compose"
alias dps="docker ps"
alias dcu="docker compose up"
alias dcd="docker compose down"

# Kubernetes
alias k="kubectl"

# Shell
alias reload="source ~/.zshrc"
